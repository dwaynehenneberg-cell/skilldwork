# Calendly event link used by the booking widget and Custom Solution CTA
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/your-name/event

# Stripe Payment Links for /pricing plan CTAs
# Freelancer defaults in code to https://buy.stripe.com/bJe7sNgDxfbd50Gekv6sw00 if unset
NEXT_PUBLIC_STRIPE_URL_FREELANCER=https://buy.stripe.com/bJe7sNgDxfbd50Gekv6sw00
NEXT_PUBLIC_STRIPE_URL_FREELANCER_PRO=https://buy.stripe.com/your-freelancer-pro-link
NEXT_PUBLIC_STRIPE_URL_AGENCY=https://buy.stripe.com/your-agency-link

# Public Reddit Ads pixel identifier used only after visitor consent
NEXT_PUBLIC_REDDIT_PIXEL_ID=a2_your-pixel-id
